#!/usr/bin/env python3
"""계층 경계 검사. docs/architecture/ARCHITECTURE.md의 계층 규칙을 코드로 확인하고 어기면 실패한다. (docs/agent/harness.md)

사용: .claude/scripts/check-boundaries               저장소 전체
      .claude/scripts/check-boundaries --base <ref>  <ref> 이후 바뀐 파일만(verify가 src/ 변경 때 쓴다)
규칙을 더하려면 rules()에 한 줄 추가하고 ARCHITECTURE.md에 같은 규칙이 있는지 확인한다.
"""
import os
import re
import subprocess
import sys


def rules(root):
    controllers = ["src/**/*.controller.ts"]
    # (이름, 검사할 파일 glob 목록, 허용 경로 glob 목록, 금지 패턴, 안내)
    return [
        ("Controller는 TypeORM을 import하지 않는다", controllers, [],
         r"^\s*import\b[^;]*?from\s+'(?:typeorm|@nestjs/typeorm)(?:/[^']*)?'",
         "DB 접근은 service로 옮기고 controller는 service만 호출한다"),
        ("Controller는 ORM 조회를 직접 하지 않는다", controllers, [],
         r"\.(?:query|createQueryBuilder|getRepository|transaction)\(|@Inject(?:Repository|DataSource|EntityManager)\b",
         "요청 · 응답 변환과 service 호출만 둔다"),
    ]


def tracked_files(root):
    out = subprocess.run(["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, text=True, check=True, stdin=subprocess.DEVNULL).stdout
    return out.splitlines()


def matches(path, pattern):
    # *는 폴더 한 단계 안에서만, **/는 0개 이상 폴더, 끝의 **는 그 아래 전부로 다룬다(fnmatch의 *는 /도 넘어 Tests까지 잡는다).
    regex = "".join(
        "(?:.*/)?" if part == "**/" else ".*" if part == "**" else "[^/]*" if part == "*" else re.escape(part)
        for part in re.split(r"(\*\*/|\*\*|\*)", pattern)
    )
    return re.fullmatch(regex, path) is not None


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                          stdin=subprocess.DEVNULL).stdout.strip() or "."
    files = tracked_files(root)
    if sys.argv[1:2] == ["--base"] and len(sys.argv) > 2:
        changed = subprocess.run(["git", "-C", root, "diff", "--name-only", sys.argv[2]], capture_output=True,
                                 text=True, check=True, stdin=subprocess.DEVNULL).stdout.splitlines()
        untracked = subprocess.run(["git", "-C", root, "ls-files", "--others", "--exclude-standard"],
                                   capture_output=True, text=True, check=True, stdin=subprocess.DEVNULL).stdout
        changed_set = set(changed) | set(untracked.splitlines())
        files = [f for f in files if f in changed_set]
    checks = rules(root)
    violations = []
    for name, targets, allowed, pattern, hint in checks:
        regex = re.compile(pattern, re.MULTILINE)
        for path in files:
            if not any(matches(path, t) for t in targets) or any(matches(path, a) for a in allowed):
                continue
            try:
                with open(os.path.join(root, path), encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for m in regex.finditer(text):
                line = text.count("\n", 0, m.start()) + 1
                violations.append(f"  {path}:{line}  [{name}] → {hint}")
    if violations:
        print("계층 경계 위반 (docs/architecture/ARCHITECTURE.md 계층 규칙):")
        print("\n".join(violations))
        return 1
    print(f"계층 경계 검사 통과 (규칙 {len(checks)}개, 파일 {len(files)}개)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
