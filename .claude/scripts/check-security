#!/usr/bin/env python3
"""보안 설정 검사. 금지 설정 · 비밀 값 · 워크플로 셸 주입이 들어오면 실패한다. (docs/agent/harness.md 보안 검사)

사용: .claude/scripts/check-security      (verify가 코드 · 설정 변경이 있을 때 실행한다)
규칙을 더하려면 FORBIDDEN · SECRET_PATTERNS에 한 줄 추가하고 docs/agent/harness.md에 같은 규칙을 적는다.
"""
import fnmatch
import os
import re
import subprocess
import sys

SELF = ".claude/scripts/check-security"

# (이름, 검사할 파일 glob 목록, 금지 줄 패턴, 안내). 백엔드는 아직 금지 설정이 없다.
FORBIDDEN = []

# 워크플로 run 안에 외부 입력을 바로 넣으면 셸 주입이 된다. env로 받아 "$VAR"로 쓴다.
# 외부 사용자가 정할 수 있는 값: 이슈 · PR · 댓글 · 리뷰 · 토론 본문과 제목, 브랜치 이름 · 라벨, 커밋 메시지 · 작성자.
WORKFLOW_INJECTION = re.compile(
    r"\$\{\{\s*(?:github\.head_ref\b"
    r"|github\.event\.(?:issue|pull_request|comment|review|review_comment|discussion|discussion_comment|head_commit"
    r"|commits|pages|workflow_run)\b[\w.\[\]*]*?\.(?:title|body|ref|label|message|name|email|page_name"
    r"|default_branch|head_branch)\b)")

SECRET_PATTERNS = [
    ("개인 키", r"-----BEGIN (RSA |EC |OPENSSH |DSA |ENCRYPTED )?PRIVATE KEY-----"),
    ("GitHub 토큰", r"\bgh[pousr]_[A-Za-z0-9]{36,}"),
    ("GitHub fine-grained 토큰", r"\bgithub_pat_[A-Za-z0-9_]{22,}"),
    ("Slack 토큰", r"\bxox[abpr]-[0-9A-Za-z-]{10,}"),
    ("Slack 웹훅", r"hooks\.slack\.com/services/T[0-9A-Z]+/B[0-9A-Z]+/[0-9A-Za-z]+"),
    ("Atlassian 토큰", r"\bATATT3[0-9A-Za-z_\-=]{20,}"),
    ("AWS 액세스 키", r"\bAKIA[0-9A-Z]{16}\b"),
    ("Google API 키", r"\bAIza[0-9A-Za-z_\-]{35}"),
    ("Sentry DSN", r"https://[0-9a-f]{32}@[^\s/\"']*sentry\.io/\d+"),
]
BINARY_EXT = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".ttf", ".otf", ".woff", ".woff2", ".zip",
              ".jar", ".xcframework", ".a", ".so", ".dylib", ".lottie", ".mp4", ".keystore", ".jks")


def tracked_files(root):
    # 로컬은 아직 추적하지 않은 파일(.gitignore 제외)도 커밋 전에 본다. -z로 한글 파일명도 그대로 받는다
    out = subprocess.run(["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, check=True).stdout
    return [os.fsdecode(p) for p in out.split(b"\0") if p]  # UTF-8이 아닌 파일명도 멈추지 않는다


def matches(path, pattern):
    return fnmatch.fnmatch(path, pattern) or fnmatch.fnmatch(path, pattern.replace("/**/", "/"))


def read(root, path):
    try:
        with open(os.path.join(root, path), encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return None


def check_forbidden(root, files):
    found = []
    for name, globs, pattern, hint in FORBIDDEN:
        regex = re.compile(pattern)
        for path in files:
            if not any(matches(path, g) for g in globs):
                continue
            text = read(root, path)
            for no, line in enumerate((text or "").splitlines(), 1):
                if line.lstrip().startswith(("#", "//")):
                    continue
                if regex.search(line):
                    found.append(f"  [{name}] {path}:{no} → {hint}")
    return found


def check_workflows(root, files):
    found = []
    for path in files:
        if not (path.startswith(".github/workflows/") and path.endswith((".yml", ".yaml"))):
            continue
        run_indent = None  # 여러 줄 run 값이 이어지는 동안 run 키의 들여쓰기
        parents = []  # (키 들여쓰기, 키): env · with 아래의 run은 셸 명령이 아니다
        for no, line in enumerate((read(root, path) or "").splitlines(), 1):
            indent = len(line) - len(line.lstrip())
            if run_indent is not None:
                if not line.strip() or indent > run_indent:
                    if WORKFLOW_INJECTION.search(line):
                        found.append(f"  [워크플로 셸 주입] {path}:{no} → env로 받아 \"$VAR\"로 쓴다")
                    continue
                run_indent = None
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            dash = re.match(r"^\s*-\s+", line)
            key_indent = dash.end() if dash else indent
            while parents and parents[-1][0] >= key_indent:
                parents.pop()
            key = re.match(r"^\s*(?:-\s+)?[\"']?([\w.-]+)[\"']?\s*:(?:\s|$)(.*)$", line)
            if not key:
                continue
            if key.group(1) == "run" and not (parents and parents[-1][1] in ("env", "with")):
                run_indent = key_indent
                if WORKFLOW_INJECTION.search(key.group(2)):
                    found.append(f"  [워크플로 셸 주입] {path}:{no} → env로 받아 \"$VAR\"로 쓴다")
                continue
            parents.append((key_indent, key.group(1)))
    return found

def check_secrets(root, files):
    found = []
    patterns = [(name, re.compile(p)) for name, p in SECRET_PATTERNS]
    for path in files:
        if path == SELF or path.lower().endswith(BINARY_EXT):
            continue
        text = read(root, path)
        if not text:
            continue
        for no, line in enumerate(text.splitlines(), 1):
            for name, regex in patterns:
                if regex.search(line):
                    found.append(f"  [비밀 값: {name}] {path}:{no} → 저장소에서 빼고 CI 비밀 · 로컬 파일로 옮긴다")
    return found


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True,
                          stdin=subprocess.DEVNULL).stdout.strip()
    files = [f for f in tracked_files(root) if os.path.isfile(os.path.join(root, f))]
    problems = check_forbidden(root, files) + check_workflows(root, files) + check_secrets(root, files)
    if problems:
        print("보안 검사 실패:")
        print("\n".join(problems))
        print("상세: docs/agent/harness.md 보안 검사")
        return 1
    print("보안 검사 통과")
    return 0


if __name__ == "__main__":
    sys.exit(main())
